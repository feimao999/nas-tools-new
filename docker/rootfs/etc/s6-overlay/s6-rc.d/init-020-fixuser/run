#!/usr/bin/with-contenv bash
# shellcheck shell=bash

function INFO() {
    echo -e "[\033[32mINFO\033[0m] ${1}"
}
function ERROR() {
    echo -e "[\033[31mERROR\033[0m] ${1}"
}
function WARN() {
    echo -e "[\033[33mWARN\033[0m] ${1}"
}

INFO "以PUID=${PUID}，PGID=${PGID}的身份启动程序..."

# 更改 nt userid 和 groupid
groupmod -o -g "$PGID" nt
usermod -o -u "$PUID" nt

# 创建目录、权限设置（当 /config 属主未变时跳过深层缓存目录全量遍历，避免大量缓存文件导致启动卡数分钟）
mkdir -p /config "${HOME}" "${WORKDIR}"
chown -R nt:nt "${WORKDIR}" "${HOME}" /etc/hosts
if [ "$(stat -c '%u:%g' /config 2>/dev/null)" != "${PUID}:${PGID}" ]; then
    chown -R nt:nt /config
else
    chown nt:nt /config /config/* 2>/dev/null || true
fi
